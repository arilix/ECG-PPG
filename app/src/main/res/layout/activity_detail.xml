<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/res-auto"
    android:id="@+id/detailRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/bg" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="9dp">
        <com.google.android.material.card.MaterialCardView style="@style/Card"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginHorizontal="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical" android:padding="10dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Durasi" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvStatDur" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textColor="?attr/colorOnSurface" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Card"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginHorizontal="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical" android:padding="10dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BPM ECG" android:textColor="@color/accent_ecg" />
                <TextView android:id="@+id/tvStatBpm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textColor="@color/accent_ecg" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Card"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginHorizontal="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="vertical" android:padding="10dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gap" android:textColor="@color/accent_spo2" />
                <TextView android:id="@+id/tvStatGap" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textColor="@color/accent_spo2" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardWindow" style="@style/Card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginTop="6dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="8dp">
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleSpan"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:singleSelection="false">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSpan5"
                    style="?attr/materialButtonOutlinedStyle" android:checkable="true" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="2dp" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="5s" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSpan10"
                    style="?attr/materialButtonOutlinedStyle" android:checkable="true" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="2dp" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="10s" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSpan15"
                    style="?attr/materialButtonOutlinedStyle" android:checkable="true" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="2dp" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="15s" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSpan30"
                    style="?attr/materialButtonOutlinedStyle" android:checkable="true" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="2dp" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="30s" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSpanAll"
                    style="?attr/materialButtonOutlinedStyle" android:checkable="true" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="2dp" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Semua" android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <SeekBar android:id="@+id/seekPos" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="1000" />
            <TextView android:id="@+id/tvRange" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:id="@+id/tvDetailInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="14dp" android:paddingTop="8dp"
        android:textColor="@color/text_secondary" android:textSize="12sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="9dp" android:paddingBottom="4dp">
        <com.google.android.material.card.MaterialCardView style="@style/ChartCard"
            android:layout_width="match_parent" android:layout_height="220dp"
            android:layout_marginHorizontal="3dp" android:layout_marginTop="6dp">
            <com.example.myapplication.ui.WaveformView android:id="@+id/dEcg"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/ChartCard"
            android:layout_width="match_parent" android:layout_height="180dp"
            android:layout_marginHorizontal="3dp" android:layout_marginTop="6dp">

            <com.example.myapplication.ui.WaveformView
                android:id="@+id/dIr"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/ChartCard"
            android:layout_width="match_parent" android:layout_height="180dp"
            android:layout_marginHorizontal="3dp" android:layout_marginTop="6dp">
            <com.example.myapplication.ui.WaveformView android:id="@+id/dRed"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"
        android:gravity="center" android:textColor="@color/text_secondary" android:textSize="11sp"
        android:text="Geser grafik atau slider untuk pindah waktu · cubit untuk zoom · ketuk dua kali untuk tampilkan semua" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
